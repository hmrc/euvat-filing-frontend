GET         /before-you-start                           controllers.supportingdocuments.BeforeYouStartSupportingDocsController.onPageLoad()
POST        /before-you-start                           controllers.supportingdocuments.BeforeYouStartSupportingDocsController.onSubmit()

GET         /any-documents                              controllers.supportingdocuments.AnyDocumentsController.onPageLoad()
POST        /any-documents                              controllers.supportingdocuments.AnyDocumentsController.onSubmit()

GET         /remove-file/$attachmentNumber<[0-9]+>      controllers.supportingdocuments.RemoveFileController.onPageLoad(attachmentNumber: Int)
POST        /remove-file/$attachmentNumber<[0-9]+>      controllers.supportingdocuments.RemoveFileController.onSubmit(attachmentNumber: Int)
